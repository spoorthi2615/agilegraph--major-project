# Application Environment
AGILEGRAPH_ENV=development
ENV=development
PORT=8000
DEBUG=True

# Authentication & Security
# Note: In production (AGILEGRAPH_ENV=production), AGILEGRAPH_SECRET_KEY is strictly required and must be >= 32 characters.
AGILEGRAPH_SECRET_KEY=change-me-to-a-secure-random-key-in-production-32chars
AGILEGRAPH_ALLOW_ANONYMOUS=0

# Database Configuration (SQLite)
DATABASE_URL=sqlite:///./dataset/cache/agilegraph.db
AGILEGRAPH_AUTH_DB=./dataset/cache/agilegraph_migrations.db

# OSV Vulnerability Intelligence
OSV_API_URL=https://api.osv.dev/v1/query
OSV_TIMEOUT_SECONDS=5.0

# Scanner File-System Boundary (Optional: root directory restricting static code scanning)
AGILEGRAPH_SCAN_ROOT=.
